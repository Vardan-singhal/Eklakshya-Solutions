# Copy to .env for local development. Never commit real credentials.
# Set the same values in Vercel Project Settings > Environment Variables.

# Required at runtime for consultation, inquiries, bookings, admin data and health checks.
# Paste your actual MongoDB Atlas or self-hosted MongoDB connection string.
MONGODB_URI=
# Optional override; otherwise use the URI's database or eklakshya_solutions.
MONGODB_DB=
# Optional: leave empty to use system DNS. Set only if Atlas SRV/TXT lookups fail.
# Applies to Node's process-wide DNS resolver, not Windows/macOS/Linux DNS settings.
MONGODB_DNS_SERVERS=

# Optional: empty disables admin. When set, use a strong password of at least 8 characters.
ADMIN_PASSWORD=

# Optional: set BOTH to enable online payments. Leave BOTH empty for manual booking.
# The Razorpay key ID is intentionally returned to checkout; the secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for Razorpay webhooks; must match the secret in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Public canonical origin (safe to expose); replace with your deployed origin before building.
# Defaults to https://eklakshya.com when unset.
NEXT_PUBLIC_SITE_URL=

# Public social profile URLs. Read dynamically by /api/social-links; HTTPS URLs only.
# Empty profiles appear as Coming soon. WhatsApp falls back to the business number.
SOCIAL_LINKEDIN_URL=
SOCIAL_GITHUB_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_WHATSAPP_URL=
